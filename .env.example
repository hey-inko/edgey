# Example names only. Use `pnpm db:env` to generate .env.local from local
# Supabase. For hosted staging, use the isolated projects in docs/staging.md.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Public Supabase publishable key (or the legacy anon key).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Storefront origin for canonical URLs, Supabase Auth and Stripe; HTTPS on Vercel.
NEXT_PUBLIC_SITE_URL=
# Leave false for staging. Enable only on the approved public origin.
EDGEY_INDEXING_ENABLED=false
# Server-only Supabase service-role key (sb_secret_... or legacy service_role JWT).
SUPABASE_SERVICE_ROLE_KEY=
# Server-only random key (at least 32 bytes) for checkout, receipt and request limits and Finder fingerprints.
EDGEY_REQUEST_HASH_KEY=
# Publish the HTTPS privacy notice and approve/schedule retention before enabling
# hosted forms and buyer magic-link sign-in.
EDGEY_PRIVACY_NOTICE_URL=
# Optional public business mailbox; leave blank until Operations approves publication.
EDGEY_PUBLIC_CONTACT_EMAIL=
EDGEY_PUBLIC_REQUESTS_ENABLED=false
# Leave false for staging. Hosted Finder attribution also requires an approved HTTPS
# privacy notice and an explicit opt-in by the visitor.
EDGEY_FINDER_ATTRIBUTION_ENABLED=false
# Loopback Postgres URL for local tests, db:fixture and demo:orders --local. Never set on Vercel.
SUPABASE_DB_URL=
# Set only while running scripts/seed-admin.ts. Use a disposable local password.
EDGEY_LOCAL_STAFF_PASSWORD=
# Optional shell override for the local browser test server (defaults to 3100).
PLAYWRIGHT_PORT=
# Operator shell only for db:fixture:staging and demo:orders --staging: direct URL and downloaded TLS CA.
EDGEY_STAGING_DB_URL=
EDGEY_STAGING_DB_CA_FILE=
# Server-only Stripe sandbox key (sk_test_...); use the full test key for staging.
STRIPE_SECRET_KEY=
# Endpoint signing secret (whsec_...), from Stripe CLI locally or the dashboard on staging.
STRIPE_WEBHOOK_SECRET=
# Keep this off until finance verifies the complete Net 30 invoice lifecycle in Stripe's sandbox.
NET30_CHECKOUT_ENABLED=false
# Random server-only bearer token of at least 32 bytes for the scheduled workers.
CRON_SECRET=
# Defaults to resend; use file only for a local development worker. Auth SMTP
# is separate and configured in the Supabase dashboard.
EMAIL_PROVIDER=resend
# Server-only Resend sending key for the environment's verified sender.
RESEND_API_KEY=
# The confirmation sender, e.g. Edgey <orders@example.com>.
EMAIL_FROM=
# Single operations mailbox for request notifications; order email does not need it.
REQUEST_STAFF_EMAIL=
# For EMAIL_PROVIDER=file, an absolute private path on the worker's local filesystem.
EMAIL_OUTBOX_DIR=

# VERCEL and NODE_ENV are set by the platform/runtime. Do not set them by hand.
