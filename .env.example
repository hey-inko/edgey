# Local values come from `pnpm db:env`, which reads them from the running
# Supabase CLI stack and writes .env.local. Nothing here is a secret.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Storefront origin for canonical URLs, Supabase Auth and Stripe redirects.
NEXT_PUBLIC_SITE_URL=
# Server-only Supabase service-role key (sb_secret_... or legacy service_role JWT).
SUPABASE_SERVICE_ROLE_KEY=
# Server-only random key (at least 32 bytes) for rate-limit and Finder fingerprints.
EDGEY_REQUEST_HASH_KEY=
# Publish the privacy notice and approve/schedule retention before enabling hosted forms.
EDGEY_PRIVACY_NOTICE_URL=
EDGEY_PUBLIC_REQUESTS_ENABLED=false
# Used by tests, the seed fixture and the search benchmark only. Never by the app.
SUPABASE_DB_URL=
# Set only while running scripts/seed-admin.ts. Use a disposable local password.
EDGEY_LOCAL_STAFF_PASSWORD=
# Server-only Stripe sandbox key (sk_test_... or an equivalent restricted test key).
STRIPE_SECRET_KEY=
# Endpoint signing secret (whsec_...), from Stripe CLI locally or the dashboard on staging.
STRIPE_WEBHOOK_SECRET=
# Random server-only bearer token for both scheduled workers.
CRON_SECRET=
# Defaults to resend; use file only for a local development worker.
EMAIL_PROVIDER=resend
# Server-only Resend sending key for the environment's verified sender.
RESEND_API_KEY=
# The confirmation sender, e.g. Edgey <orders@example.com>.
EMAIL_FROM=
# Single operations mailbox for request notifications; order email does not need it.
REQUEST_STAFF_EMAIL=
# For EMAIL_PROVIDER=file, an absolute private path on the worker's local filesystem.
EMAIL_OUTBOX_DIR=
